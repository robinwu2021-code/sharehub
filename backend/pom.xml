<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 站在 neargo 地基上（ADR-006）：继承 neargo-parent → 得 Spring Boot 4.0.x + Java 21
         + maven-enforcer(锁 JDK21) + MyBatis-Plus BOM + neargo commons 版本管理。
         relativePath 留空 → 从本机 ~/.m2 私仓解析（neargo commons 已发布/安装于此）。 -->
    <parent>
        <groupId>ai.neargo</groupId>
        <artifactId>neargo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>ai.neargo.sharehub</groupId>
    <artifactId>sharehub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>sharehub-parent</name>
    <description>共享充电宝/充电桩运营管理系统 · 服务端父 POM（独立仓库，仅依赖 ai.neargo:* 基础包）</description>

    <!-- MVP=合并模块化单体（ADR-001）：先一个 modulith app 点亮运营端；access-gateway 后续裂解为独立 module -->
    <modules>
        <!-- ADR-017 S1：横切基础设施先抽出，它是唯一零业务依赖的模块 -->
        <module>sharehub-common</module>
        <!-- ADR-017 §5.1：只有接口，谁都能依赖，自己只依赖 common -->
        <module>sharehub-api</module>
        <!-- 业务服务实现（jar，不可独立启动）。先拆最小的 gateway 验证模式 -->
        <module>sharehub-svc-platform</module>
        <module>sharehub-svc-gateway</module>
        <module>sharehub-svc-core</module>
        <module>sharehub-svc-ops</module>
        <module>sharehub-svc-finance</module>
        <module>sharehub-app</module>
        <!-- 微服务形态启动模块：与单体共用同一份 svc，差别只有依赖列表 -->
        <module>sharehub-app-gateway</module>
    </modules>


    <!-- ── 依赖纪律卡口（v4/12 §5.2 的模块依赖矩阵 · v4/08 §三）────────────────────
         这里只放**全局**规则；每个模块的边界规则写在各自 pom 的 module-boundary 执行里。
         为什么要卡：模块边界一旦被穿，编译照过、测试照绿，只有真拆服务的那天才发现拆不动
         （arch-guard 的 G3 查的是「注入了别的服务的实现类」，这里查的是「Maven 层面依赖了谁」，
         两者互补：前者防写法上的越界，后者防依赖声明上的越界）。 -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>sharehub-global-rules</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <!-- 同一构件出现两个版本 → 失败。2026-09-23 实测全部模块零冲突，
                                     所以这条是「保持现状」而不是「先欠着」。 -->
                                <dependencyConvergence/>
                                <!-- 同一 pom 里把同一构件写两遍（复制粘贴的典型产物） -->
                                <banDuplicatePomDependencyVersions/>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- ai-shop 的构件一律不许依赖。ADR-024 定了将来只放行三个
                                             服务客户端 / 契约（pay-client · shop-job-api · shop-job-target），
                                             届时把它们加进 includes；在那之前一个都不许进来。 -->
                                        <exclude>ai.neargo.shop:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
