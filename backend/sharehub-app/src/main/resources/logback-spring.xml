<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志落盘配置。2026-09-24 新增 —— 此前**没有这个文件**，走 Spring Boot 默认（只有 console），
  systemd 把 stdout 全塞进 journald。

  后果不是"不好看"，是两件具体的事：
    · B7 做的 traceparent 透传发挥不出价值 —— 链路 id 打在 journald 里等于没打，
      跨进程排障只能逐个比时间戳；
    · 出了问题只能翻 journald，而它不按应用切分、不长期保留、按 traceId grep 很难。

  ## 切分与压缩的分工

  logback 负责**切**（按天 + 按大小），logrotate 负责**压缩与删除**。
  不是二选一：
    · 切必须由 logback 做 —— 它知道一条日志何时写完，切在记录边界上；
      外部工具切会把一条多行异常栈劈成两半，而那正是你最需要读完整的东西；
    · 压缩交给 logrotate —— 不占应用进程的 CPU。

  删除做**双保险**（logback maxHistory + logrotate rotate）：
  只靠 logback，应用长期不重启时清理不一定触发；
  只靠 logrotate，应用自己切出来的文件名它未必匹配。

  ## 为什么有 totalSizeCap

  保留天数管的是正常情况，**容量上限管的是异常情况**：
  一次异常风暴能在几小时内写满磁盘，而磁盘满会让数据库也一起停。
  宁可丢最老的日志，不能让磁盘写满。
-->
<configuration scan="true" scanPeriod="60 seconds">
    <!--
      LOG_DIR 的默认值**必须是相对路径**。写成绝对路径（曾经是 /data/log/powerbank）
      的后果不是"日志位置不对"，而是：任何创建不了那个目录的环境 —— 本机、CI、
      测试 —— logback 初始化就报错，Spring Boot 4 把它升级成 context 加载失败，
      于是几百个毫不相干的测试一起变红，根因埋在最前面那条 logback 自检里。
      绝对路径由部署环境用 SHAREHUB_LOG_DIR 注入（见 deploy/tencent/systemd）。
    -->
    <springProperty scope="context" name="LOG_DIR" source="sharehub.log.dir" defaultValue="logs"/>
    <springProperty scope="context" name="KEEP_DAYS" source="sharehub.log.keep-days" defaultValue="20"/>
    <springProperty scope="context" name="MAX_FILE" source="sharehub.log.max-file-size" defaultValue="200MB"/>
    <springProperty scope="context" name="TOTAL_CAP" source="sharehub.log.total-size-cap" defaultValue="10GB"/>
    <springProperty scope="context" name="APP" source="spring.application.name" defaultValue="sharehub-app"/>

    <!--
      格式里的两个 MDC 字段是这份配置的重点：
        %X{traceId}  B7 的 TraceContext 写入，跨进程串同一次请求
        %X{actor}    当前操作人，由 MdcActorFilter 从 CurrentUser 取

      没有 traceId，跨进程排障就是肉眼比时间戳；
      没有 actor，日志只能告诉你「出错了」，不能告诉你「谁在操作时出错了」。
    -->
    <property name="PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-}] [%X{actor:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATTERN}</pattern><charset>UTF-8</charset></encoder>
    </appender>

    <!-- 应用日志：全量 -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app/${APP}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app/${APP}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE}</maxFileSize>
            <maxHistory>${KEEP_DAYS}</maxHistory>
            <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern><charset>UTF-8</charset></encoder>
    </appender>

    <!--
      错误日志单独一份：不是为了"分类整齐"，是为了**告警能接一个小文件**。
      让告警去 tail 一个混着 INFO 的 200MB 文件，它要么漏要么慢。
    -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/error/${APP}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/error/${APP}-error-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE}</maxFileSize>
            <maxHistory>${KEEP_DAYS}</maxHistory>
            <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern><charset>UTF-8</charset></encoder>
    </appender>

    <!--
      异步包一层：日志写盘不该拖慢业务线程。
      neverBlock=true —— **队列满时丢日志而不是阻塞请求**。
      这个取舍要说清楚：丢的是日志，阻塞的是用户请求。日志重要，但没有重要到
      可以让下单卡住。真丢了会有 discardingThreshold 的告警记录。
    -->
    <appender name="ASYNC_APP" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="APP_FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>   <!-- 0 = 不因为队列将满就丢 WARN/ERROR -->
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>    <!-- 取调用点信息很贵，异步下尤其 -->
    </appender>

    <!-- 本地开发：只要 console，别往 /data/log 写 -->
    <springProfile name="dev | test | local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!dev &amp; !test &amp; !local">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_APP"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
    </springProfile>

    <!-- 迁移与建表噪音很大，出问题时再单独开 -->
    <logger name="org.flywaydb" level="WARN"/>
    <!-- MyBatis-Plus 的 SQL 日志在生产会把 app 日志淹掉，且可能带出敏感参数 -->
    <logger name="com.baomidou.mybatisplus" level="WARN"/>
</configuration>
