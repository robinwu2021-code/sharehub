<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.powerbank</groupId>
        <artifactId>powerbank-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>powerbank-app</artifactId>
    <packaging>jar</packaging>
    <name>powerbank-app</name>
    <description>powerbank 合并模块化单体：运营端 BFF/业务域（骨架：内存种子，零基础设施启动）</description>

    <dependencies>
        <!-- 复用 neargo L1 核心（Result/ErrorCode/IdGenerator/PageResult 等纯库，无 autoconfig）。
             注意：对外响应契约用 powerbank 自有 ApiResult/PageData（msg/records），与 neargo 命名有别。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-core</artifactId>
            <version>${neargo.version}</version>
        </dependency>
        <!-- U1 上推：复用 neargo RBAC（@perm/PermissionResolver/AuthSubject）。仅启用 RbacAutoConfiguration，
             其它 auto-config（Security/SessionStore）经 spring.autoconfigure.exclude 关闭（powerbank 自持会话/链）。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-security</artifactId>
            <version>${neargo.version}</version>
        </dependency>
        <!-- U2 上推：复用 neargo 数据权限引擎（scope 包）。仅启用 DataScopeAutoConfiguration，
             其 DataAutoConfiguration 经 spring.autoconfigure.exclude 关闭（powerbank 自持 MyBatis 配置/实体）。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-data</artifactId>
            <version>${neargo.version}</version>
        </dependency>

        <!-- P4 持久化：MyBatis-Plus（Boot4 starter，版本由 neargo-parent 的 mybatis-plus-bom 管） + MySQL 驱动。
             直接引 MP（不引 neargo-common-data，避免其传递 common-security 的鉴权自动配置）。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 内置拦截器（分页/乐观锁）在 extension，boot4 starter 不传递引入，显式加（版本由 bom 管 3.5.16） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 运营端后端鉴权 MVP：StaffTokenAuthFilter + @PreAuthorize(@perm.can) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 可切换 TokenStore 的 redis 模式（默认 memory，不用则连接惰性、不影响启动）。
             管理端点关 redis 健康检查（management.health.redis.enabled=false）避免无 Redis 时 readiness DOWN。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
