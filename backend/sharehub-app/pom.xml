<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.neargo.sharehub</groupId>
        <artifactId>sharehub-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sharehub-app</artifactId>
    <packaging>jar</packaging>
    <name>sharehub-app</name>
    <description>powerbank 合并模块化单体：运营端 BFF/业务域（骨架：内存种子，零基础设施启动）</description>

    <dependencies>
        <!-- ADR-017 S1：横切基础设施。app 依赖 common，反向绝不允许 -->
        <dependency>
            <groupId>ai.neargo.sharehub</groupId>
            <artifactId>sharehub-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.sharehub</groupId>
            <artifactId>sharehub-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- app 聚合 svc-*：这就是「换个 app 就换形态」的落点 -->
        <dependency>
            <groupId>ai.neargo.sharehub</groupId>
            <artifactId>sharehub-svc-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.sharehub</groupId>
            <artifactId>sharehub-svc-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.sharehub</groupId>
            <artifactId>sharehub-svc-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.sharehub</groupId>
            <artifactId>sharehub-svc-ops</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.neargo.sharehub</groupId>
            <artifactId>sharehub-svc-finance</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 复用 neargo L1 核心（Result/ErrorCode/IdGenerator/PageResult 等纯库，无 autoconfig）。
             注意：对外响应契约用 powerbank 自有 ApiResult/PageData（msg/records），与 neargo 命名有别。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-core</artifactId>
            <version>${neargo.version}</version>
        </dependency>
        <!-- U1 上推：复用 neargo RBAC（@perm/PermissionResolver/AuthSubject）。仅启用 RbacAutoConfiguration，
             其它 auto-config（Security/SessionStore）经 spring.autoconfigure.exclude 关闭（powerbank 自持会话/链）。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-security</artifactId>
            <version>${neargo.version}</version>
        </dependency>
        <!-- U2 上推：复用 neargo 数据权限引擎（scope 包）。仅启用 DataScopeAutoConfiguration，
             其 DataAutoConfiguration 经 spring.autoconfigure.exclude 关闭（powerbank 自持 MyBatis 配置/实体）。 -->
        <dependency>
            <groupId>ai.neargo</groupId>
            <artifactId>neargo-common-data</artifactId>
            <version>${neargo.version}</version>
        </dependency>

        <!-- P4 持久化：MyBatis-Plus（Boot4 starter，版本由 neargo-parent 的 mybatis-plus-bom 管） + MySQL 驱动。
             直接引 MP（不引 neargo-common-data，避免其传递 common-security 的鉴权自动配置）。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 内置拦截器（分页/乐观锁）在 extension，boot4 starter 不传递引入，显式加（版本由 bom 管 3.5.16） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 运营端后端鉴权 MVP：StaffTokenAuthFilter + @PreAuthorize(@perm.can) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 可切换 TokenStore 的 redis 模式（默认 memory，不用则连接惰性、不影响启动）。
             管理端点关 redis 健康检查（management.health.redis.enabled=false）避免无 Redis 时 readiness DOWN。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 数据库迁移。为什么不用 spring.sql.init：ALTER 不幂等、v2-alter 里有 CREATE DATABASE/USE
             会切库污染后续脚本、且无版本记录（每次启动重跑）。Flyway 逐脚本一次性执行并记录到
             flyway_schema_history，是 ddl/README 一直建议的方案。 -->
        <!-- ⚠️ Boot 4 把自动配置按技术拆成独立模块：flyway 的 AutoConfiguration 不在
             spring-boot-autoconfigure 里，只加 flyway-core 不会生效（jar 在 classpath 但迁移不执行，
             且没有任何报错 —— 表数不变、无 flyway_schema_history，很容易误判为"跑过了"）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>11.14.1</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <version>11.14.1</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            ArchUnit：字节码级的架构断言（B2 最后一项）。

            与 scripts/arch-guard.py **分工而非重复** —— 那四条（跨模块 JOIN / 跨服务事务 /
            跨服务注入 / common 零业务依赖）都是正则能判的文本特征。ArchUnit 补的是正则
            根本做不到的两类：① 看得穿泛型、继承、间接调用的真实依赖；② 包循环检测
            （循环是图的性质，逐行扫描无从发现）。
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 模块边界（v4/12 §5.2）：启动模块可依赖全部业务域。
                 **为什么现在不禁 sharehub-svc-gateway**：今天是单体形态，网关内嵌在本进程里
                 （ADR-017 双形态：本地实现在 classpath 上就走本地），这条依赖是有意为之。
                 v4/12 的矩阵描述的是 **S5 之后**的目标形态（网关独立部署 :8091，
                 业务侧只经 DeviceCommandPort 远程调用）。
                 **S5 落地时把 sharehub-svc-gateway 加进下面的 excludes**，那一刻这条卡口才有意义；
                 现在就加只会逼着把正常的单体形态绕过去。
                 禁 sharehub-app-gateway 则是任何时候都成立的：两个启动模块互相依赖没有正当理由。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>module-boundary</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>ai.neargo.sharehub:sharehub-app-gateway</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
