<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.neargo.sharehub</groupId>
    <artifactId>sharehub-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>sharehub-common</artifactId>
  <name>sharehub-common</name>
  <description>
    横切基础设施：Result/分页/异常 · 受信头与认证 · 数据范围 · BaseEntity/审计填充 ·
    CRUD 基类 · 业务键前缀 · 事件总线 · i18n。

    ADR-017 S1：这是 16 模块拆分的第一步，也是唯一「零业务依赖」的模块 ——
    它不认识任何业务包，故可被全部 svc-* 依赖而不制造环。
    实测前提：common/ 与 auth/ 对业务包的反向依赖为 0。

    ⚠️ 不要往这里放业务代码。判据很硬：**本模块不许 import 任何 ai.neargo.sharehub.&lt;业务包&gt;**。
    一旦破例，全部 svc-* 都会通过它间接依赖那个业务包，拆分就地失效。
  </description>
  <packaging>jar</packaging>

  <dependencies>
    <!--
      测试依赖。**sharehub-common 此前没有测试目录** —— 它的类只能跟着 sharehub-app 一起测，
      而 app 模块常年被并行会话的在途改动挡住编译（2026-09-24 实测连续 10 分钟不可用）。
      基座模块的东西（CurrentUser / CachedTokenStore）本来就不依赖 app，
      让它们能独立跑测试，既是分层该有的样子，也让基座的验证不被上层阻塞。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- neargo commons：Result/PageResult/ErrorCode · 受信头与权限 SPI · 数据范围 -->
    <dependency>
      <groupId>ai.neargo</groupId>
      <artifactId>neargo-common-core</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.neargo</groupId>
      <artifactId>neargo-common-security</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.neargo</groupId>
      <artifactId>neargo-common-data</artifactId>
    </dependency>

    <!-- 持久化：BaseEntity/审计填充/CRUD 基类需要 MyBatis-Plus 注解与 BaseMapper -->
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-extension</artifactId>
    </dependency>

    <!-- Web/Security：ApiResponseWrapper 与认证过滤器 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- 会话存储的 Redis 实现（TokenStore SPI 的一种） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

    <!-- 模块边界（v4/12 §5.2）：最底层，不许依赖任何 sharehub 模块（它被所有人依赖，一旦反向依赖就成环） -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>module-boundary</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>ai.neargo.sharehub:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
