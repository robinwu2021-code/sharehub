[Unit]
Description=powerbank sharehub-app (Spring Boot / Java 21)
After=network.target mysql97.service
Wants=mysql97.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/data/app/powerbank/sharehub-app
# 真凭据 + 端口 + DB URL 都在 env file 里（600）。
EnvironmentFile=/data/app/powerbank/sharehub-app/sharehub-app.env
# JVM：与 ai-shop 相同上限（7.5G 机器上，两应用共存需克制）。
Environment="JAVA_OPTS=-Xms256m -Xmx768m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+ExitOnOutOfMemoryError -Djava.security.egd=file:/dev/./urandom -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"
# 日志目录。logback 只读 SHAREHUB_LOG_DIR —— 此前这里设的是 LOG_HOME，没有任何地方读它。
Environment="SHAREHUB_LOG_DIR=/data/log/powerbank"
# append: 的目标文件由 systemd 在 ExecStart **之前**打开，它不会替你建父目录 ——
# 目录不在，服务起都起不来（而不是"日志没了"）。所以这一行不能省。
ExecStartPre=/bin/mkdir -p /data/log/powerbank/app /data/log/powerbank/error
ExecStart=/usr/lib/jvm/java-21-openjdk-amd64/bin/java $JAVA_OPTS -jar /data/app/powerbank/sharehub-app/sharehub-app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s
# 应用日志由 logback 自己落盘（见 logback-spring.xml）；这里接的是 logback 之前、
# 之外的输出：JVM 崩溃、OOM killer、启动失败。这些恰恰是最需要留痕的，
# 而 journald 不按应用切分也不长期保留。
StandardOutput=append:/data/log/powerbank/stdout.log
StandardError=append:/data/log/powerbank/stdout.log
# 收紧文件描述符
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
