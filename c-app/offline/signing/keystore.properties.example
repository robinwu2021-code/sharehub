# C 端正式签名的配置。**复制成同目录下的 keystore.properties 再填**，那一份永不进 git。
#
#   cp signing/keystore.properties.example signing/keystore.properties
#   vi signing/keystore.properties          # 填下面五项
#   chmod 600 signing/keystore.properties   # 密码在里面，别让同机其他账号读到
#   ./gen-release-keystore.sh               # 生成 keystore 并打印三个指纹
#
# 这份 .example 是模板，**不要往里面填真密码** —— 它是被跟踪的文件，
# 填了就等于把密码提交进了历史，而 git 历史删不干净。

# keystore 落在哪里。**放仓库外**：仓库会被 clone、被打包、被 CI 拉取，
# 而这把钥匙丢了或泄露了，ai.neargo.powerbank 这个包名就再也发不出可信的更新。
storeFile=/Users/你的用户名/keys/neargo-release.jks

storePassword=
keyPassword=

# 别名。一个 keystore 可以放多把 key，用别名区分。
keyAlias=neargo

# 证书主体。**签发后不可改**，会永久显示在证书里，应用商店与推送后台会展示它。
# ⚠️ 别图省事借用 ai-shop 那把 hxmall-release.jks —— 那张证书的主体写的是深圳虹选。
dname=CN=Neargo, O=Neargo FZ-LLC, L=Dubai, ST=Dubai, C=AE

# 有效期（天）。10950 ≈ 30 年。**证书过期后无法再发布更新**，宁长勿短。
validityDays=10950
