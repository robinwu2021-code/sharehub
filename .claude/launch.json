{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ops-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "ops-web"
    },
    {
      "name": "c-app-h5",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:h5"
      ],
      "port": 5174,
      "cwd": "c-app"
    },
    {
      "name": "c-app-h5-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:h5:mock"
      ],
      "port": 5175,
      "autoPort": true,
      "cwd": "c-app"
    },
    {
      "name": "opskit-local",
      "runtimeExecutable": "opskit/scripts/dev-run.sh",
      "runtimeArgs": [],
      "port": 8090
    },
    {
      "name": "flow-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4310",
        "--directory",
        ".e2e/flow-e2e-mock/out"
      ],
      "port": 4310
    }
  ]
}
