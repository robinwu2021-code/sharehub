{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ops-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "ops-web"
    },
    {
      "name": "c-app-h5",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:h5"
      ],
      "port": 5174,
      "cwd": "c-app"
    },
    {
      "name": "c-app-h5-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:h5:mock"
      ],
      "port": 5175,
      "autoPort": true,
      "cwd": "c-app"
    },
    {
      "name": "opskit-local",
      "runtimeExecutable": "opskit/scripts/dev-run.sh",
      "runtimeArgs": [],
      "port": 8090
    },
    {
      "name": "flow-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4310",
        "--directory",
        ".e2e/flow-e2e-mock/out"
      ],
      "port": 4310
    },
    {
      "name": "backend-walk",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; [ -f backend/.env.mail.local ] && . backend/.env.mail.local; set +a; exec $HOME/.local/opt/jdk-21.0.13+9/Contents/Home/bin/java -Duser.timezone=UTC -jar backend/sharehub-app/target/sharehub-app-0.1.0-SNAPSHOT.jar --spring.datasource.url='jdbc:mysql://127.0.0.1:3306/test_walk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8' --sharehub.dev-mode.enabled=true --sharehub.seed.enabled=true"
      ],
      "port": 8080
    },
    {
      "name": "ops-web-real",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NEXT_PUBLIC_USE_MOCK=0 NEXT_PUBLIC_API_BASE=http://localhost:8080 exec npm run dev"
      ],
      "port": 3000,
      "cwd": "ops-web"
    },
    {
      "name": "inventory-svc-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "INVENTORY_INSTANCE_CODE=TEST INVENTORY_INSTANCE_ALLOWED_SYSTEMS=SHAREHUB INVENTORY_ADMIN_TOKEN=local-admin-token INVENTORY_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3306/inventory_test?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false' INVENTORY_DATASOURCE_USERNAME=root INVENTORY_DATASOURCE_PASSWORD= SERVER_PORT=8086 exec $HOME/.local/opt/jdk-21.0.13+9/Contents/Home/bin/java -Duser.timezone=UTC -jar $HOME/.local/opt/inventory-svc/inventory-svc.jar --inventory.flyway-locations=filesystem:/Users/workingowl/.local/var/mysql/flyway-conv/inventory"
      ],
      "port": 8086,
      "cwd": "."
    },
    {
      "name": "backend-inv",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "CRED=$HOME/.local/etc/inventory-sharehub-cred.json; KEY=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[\"appKey\"])' $CRED); SEC=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[\"appSecret\"])' $CRED); exec $HOME/.local/opt/jdk-21.0.13+9/Contents/Home/bin/java -Duser.timezone=UTC -cp backend/sharehub-app/target/classes:$(cat backend/sharehub-app/target/runtime-classpath.txt) ai.neargo.sharehub.SharehubApplication --server.port=8085 --spring.datasource.url='jdbc:mysql://127.0.0.1:3306/test_sharehub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8' --sharehub.dev-mode.enabled=true --sharehub.inventory.base-url=http://127.0.0.1:8086 --sharehub.inventory.app-key=$KEY --sharehub.inventory.app-secret=$SEC"
      ],
      "port": 8085
    },
    {
      "name": "backend-inv-8088",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "CRED=$HOME/.local/etc/inventory-sharehub-cred.json; KEY=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[\"appKey\"])' $CRED); SEC=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[\"appSecret\"])' $CRED); exec $HOME/.local/opt/jdk-21.0.13+9/Contents/Home/bin/java -Duser.timezone=UTC -cp backend/sharehub-app/target/classes:$(cat backend/sharehub-app/target/runtime-classpath.txt) ai.neargo.sharehub.SharehubApplication --server.port=8085 --spring.datasource.url='jdbc:mysql://127.0.0.1:3306/test_sharehub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8' --sharehub.dev-mode.enabled=true --sharehub.inventory.base-url=http://127.0.0.1:8088 --sharehub.inventory.app-key=$KEY --sharehub.inventory.app-secret=$SEC"
      ],
      "port": 8085
    },
    {
      "name": "backend-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "CRED=$HOME/.local/etc/inventory-pblocal-cred.json; KEY=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[\"appKey\"])' $CRED); SEC=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[\"appSecret\"])' $CRED); exec $HOME/.local/opt/jdk-21.0.13+9/Contents/Home/bin/java -Duser.timezone=UTC -jar $HOME/.local/opt/powerbank/sharehub-app.jar --server.port=8080 --spring.datasource.url='jdbc:mysql://127.0.0.1:3306/pb_local?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8' --sharehub.dev-mode.enabled=true --sharehub.admin.password=local-dev --sharehub.seed.enabled=true --sharehub.cors.allowed-origins=http://localhost:3100 --sharehub.inventory.base-url=http://127.0.0.1:8088 --sharehub.inventory.app-key=$KEY --sharehub.inventory.app-secret=$SEC"
      ],
      "port": 8080
    },
    {
      "name": "ops-web-local-real",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../powerbank-local-real/ops-web && NEXT_PUBLIC_USE_MOCK=0 NEXT_PUBLIC_API_BASE=http://localhost:8080 exec npx next dev -p 3100"
      ],
      "port": 3100
    },
    {
      "name": "ops-web-local-mock",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../powerbank-local-mock/ops-web && exec npx next dev -p 3200"
      ],
      "port": 3200
    }
  ]
}
