# 后端 API「源」。端点路径已自带 /api、/internal 前缀（lib/api/http.ts），故此处填「源」不填 /api：
#  - 同源 nginx 反代（生产）：留空 → 同源请求 /api/** 、/internal/**
#  - 跨源本地开发：指向后端源，如 http://localhost:8080
NEXT_PUBLIC_API_BASE=
# 用 mock 数据运行（无后端时置 1；接后端置 0）
NEXT_PUBLIC_USE_MOCK=1
# 产品交付阶段（1=MVP / 2=规模化 / 3=生态）。默认 1。
# > CURRENT_PHASE 的功能在导航灰显（P2/P3 徽章）、直达兜底。切期改此值并重新 build。
# 依据 docs/requirements/PRD-分期路线图.md。
NEXT_PUBLIC_CURRENT_PHASE=1
# 产品分期控制（1=MVP T1-T3 / 2=规模化 T4-T6 / 3=生态 T7-T9）
# 超出当前阶段的功能在导航中灰显锁定，不产生路由入口。
NEXT_PUBLIC_CURRENT_PHASE=1
# 子路径部署（可选）
# NEXT_PUBLIC_BASE_PATH=/powerbank/ops-web
